cache/
web/node_modules/
web/.next/

# --- personal tax data: NEVER in version control (history goes public at the AGPL flip) ---
data/
inputs/
out/
output/
*.pdf
# blank official IRS templates only (public-domain US gov works) — the comment
# MUST be on its own line: git .gitignore has no inline comments, so a trailing
# "# ..." on the negation below made it a literal (never-matching) pattern and
# silently kept the templates ignored (telos-ops#10).
!forms/templates/**/*.pdf
!forms/templates/*.pdf
*.p12
*.key

# --- tuned ingestion prompts: real *.txt live in the private telos-ops repo ---
# only the *.txt.example stubs are committed here (public AGPL); the tuned
# prompts are loaded at runtime and must never be committed.
src/telos/ingest/prompts/*.txt

# secrets / env
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/
*.egg-info/

# os / editor
.DS_Store
.idea/
.vscode/
.coverage
coverage.xml
htmlcov/
# AGENTS.md is the CANONICAL agent-instruction file since the 2026-07-23
# migration; CLAUDE.md is only a symlink to it. This file ignored the
# symlink and not the file it points at, so the content that must never be
# public was one `git add -A` from being committed — and it was sitting
# untracked in the working tree when this was found (2026-08-21).
# Both names, always: see ~/Development/AGENTS.md.
AGENTS.md
CLAUDE.md
AGENTS.md
